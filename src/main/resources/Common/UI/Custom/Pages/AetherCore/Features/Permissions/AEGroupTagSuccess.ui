Button #Tag {
    LayoutMode: Left;
    Anchor: (Height: 36, Bottom: 4);
    Padding: (Horizontal: 12);
    Style: (
        Default: (Background: #2f5c3f(0.7)),
        Hovered: (Background: #2f5c3f(0.9))
    );

    Label #Name {
        Anchor: (Full: 0);
        Text: "Group";
        Style: (FontSize: 13, VerticalAlignment: Center, TextColor: #ffffff(0.95));
    }
}
