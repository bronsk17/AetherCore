Button #Cell {
    FlexWeight: 1;
    Anchor: (Right: 2);
    Style: (
        Default: (Background: #ffffff(0.1)),
        Hovered: (Background: #ffffff(0.16))
    );

    Label #Text {
        Anchor: (Left: 8, Right: 8, Top: 0, Bottom: 0);
        Style: (FontSize: 13, RenderBold: true, TextColor: #ffffff(0.6), VerticalAlignment: Center);
    }
}
