Group #Details {
    LayoutMode: Left;

    Group #Avatar {
        Anchor: (Width: 512, Height: 512, Right: 20);
    }

    Group #Content {
        LayoutMode: Top;
        FlexWeight: 1;

        Group #Rows {
            LayoutMode: Top;
        }

        Group #Actions {
            LayoutMode: Left;
            Anchor: (Top: 16);
        }

        Group #Cards {
            LayoutMode: Left;
            Anchor: (Height: 100, Top: 20);
        }
    }
}
