$Common = "../../../../Common.ui";

$Common.@PageOverlay {
    LayoutMode: Middle;
    Anchor: (Full: 0);

    $Common.@DecoratedContainer {
        Anchor: (Width: 480, Height: 500);

        #Title {
            Label #TitleLabel {
                Anchor: (Height: 38);
                Padding: (Horizontal: 19);
                Style: (FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #b4c8c9, VerticalAlignment: Center);
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 20);

            Group #Rows {
                LayoutMode: TopScrolling;
                ScrollbarStyle: $Common.@DefaultScrollbarStyle;
                FlexWeight: 1;
                Anchor: (Bottom: 16);
            }

            Group {
                LayoutMode: Center;
                Anchor: (Top: 8);

                Group #ExitButton {}
            }
        }
    }
}
