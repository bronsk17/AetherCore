$Common = "../../../../Common.ui";

$Common.@SimpleContainer #Shell {
    LayoutMode: Top;
    FlexWeight: 1;

    Group #TitleBar {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8, Right: 12);

        Label #Title {
            FlexWeight: 1;
            Anchor: (Height: 44);
            Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff(0.85), VerticalAlignment: Center);
        }

        Group #Actions {
            LayoutMode: Left;
            Anchor: (Height: 44, Right: 12);
        }

        Group #Search {
            Anchor: (Height: 44);
        }
    }

    Group #Header {
        Anchor: (Height: 24, Bottom: 2, Right: 12);
    }

    Group #RowsScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;
        FlexWeight: 1;
        Anchor: (Bottom: 12);

        Group #Rows {
            LayoutMode: Top;
        }
    }

    Group #Pagination {
        LayoutMode: CenterMiddle;
        Anchor: (Height: 54);
    }
}
